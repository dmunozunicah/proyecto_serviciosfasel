<article class="product-card">
  <div class="product-card-image">
    <img src="{{imagen}}" alt="{{alt}}">
  </div>

  <div class="product-card-body">
    <h2>{{nombre}}</h2>
    <p>{{descripcion}}</p>

    <p>
      <strong>Precio:</strong>
      {{precio}}
    </p>

    <p>
      <strong>Medida:</strong>
      {{medida}}
    </p>

  </div>
</article>
