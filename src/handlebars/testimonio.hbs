<article class="testimonial-card">
  <p class="testimonial-comment">&ldquo;{{comentario}}&rdquo;</p>

  <div class="testimonial-author">
    <div class="testimonial-avatar">
      <img src="{{foto}}" alt="{{alt}}">
    </div>

    <div class="testimonial-author-info">
      <h2>{{nombre}}</h2>
      <span>{{empresa}}</span>
    </div>
  </div>
</article>
